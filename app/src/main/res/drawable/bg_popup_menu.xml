<?xml version="1.0" encoding="utf-8"?>
<!-- Popup/overflow menu surface: trench pressed one shade above the abyss,
     hairline edge, 12dp mid radius per the Auros shape discipline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/auros_trench" />
    <stroke android:width="1dp" android:color="@color/auros_hairline" />
    <corners android:radius="12dp" />
</shape>
