<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <View android:layout_width="6dp" android:layout_height="6dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_eyebrow_dot" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSION COMPLETE"
                android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
        </LinearLayout>

        <!-- R6: the payoff — XP count-up with the Auros burst behind it -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp">

            <com.migul.treningsprogram.ui.log.AurosBurstView
                android:id="@+id/burst"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tv_xp_countup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/game_gold" />

                <TextView
                    android:id="@+id/tv_xp_breakdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:letterSpacing="-0.01"
            android:textColor="@color/auros_snow"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_session_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="10dp" />

        <!-- PRs: each record with its numbers — new vs previous best -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_prs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/game_gold"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_prs_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💥 Personal Records"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/game_gold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layout_pr_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Achievement unlocks as tier-styled cards (R5 tier model) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_achievements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_achievements_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏆 Achievement Unlocked!"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layout_achievement_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Challenges completed + the Perfect Week moment -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_challenges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="14dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Challenges"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/layout_challenge_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_perfect_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold"
                    android:textColor="@color/game_gold"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
