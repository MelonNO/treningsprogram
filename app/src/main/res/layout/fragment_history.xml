<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Auros hero band — item 03 (2026-08): this tab was already full-bleed; it is now the
         reference the other three match, and it gains the teal accent bar the other three have
         (the user's explicit choice: add the bar here rather than remove it elsewhere). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_hero_wash">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <View android:layout_width="6dp" android:layout_height="6dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_eyebrow_dot" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSIGHTS"
                android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/auros_snow" />

        <View
            android:layout_width="52dp"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_gradient_accent" />
    </LinearLayout>

    <!-- Pill-style selected tab: a full-height reef capsule glides between tabs instead of the
         thin underline — reads as a segmented control on the abyss. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/auros_abyss"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicator="@drawable/tab_indicator_pill"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorColor="@color/auros_reef"
        app:tabIndicatorAnimationMode="elastic"
        app:tabTextColor="@color/auros_fog_dim"
        app:tabSelectedTextColor="@color/auros_ice"
        app:tabRippleColor="#1AEDFFFE" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
