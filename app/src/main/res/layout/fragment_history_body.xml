<?xml version="1.0" encoding="utf-8"?>
<!-- Body-progress batch 2026-08-04 (brief 02).

     Layout order encodes user decision 10: GRAPHS ARE THE PRIMARY FUNCTION, logging is secondary.
     The range control and the charts come first; the logging card sits below them and is COLLAPSED
     to a single header row until the user taps "Log entry" (A7 — the same reveal pattern the Home
     body-weight card already uses, so it reads as one app). -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Time scale (decision 7 / A6) ─────────────────────────────────────────────── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="4dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_body_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_body_1m"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1M" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_body_3m"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="3M" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_body_6m"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6M" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_body_1y"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1Y" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_body_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_body_range"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Custom dates" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_body_range_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Clear" />

        </LinearLayout>

        <!-- Whole-tab empty state: nothing logged at all, in any series, ever. -->
        <TextView
            android:id="@+id/tv_body_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log a measurement to start tracking your body progress."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:paddingVertical="40dp"
            android:visibility="gone" />

        <!-- A5: profile pointer. Shown only when girths exist but height/sex do not, so the user
             understands why there is no body-fat chart yet. -->
        <TextView
            android:id="@+id/tv_body_profile_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add your height and sex in Settings → Training to estimate body fat."
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- ── Charts ───────────────────────────────────────────────────────────────────── -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_body_fat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.Auros.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Body fat"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Average of the US Navy method and RFM (%)"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_body_fat_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/auros_snow"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <com.migul.treningsprogram.ui.history.StrengthChartView
                    android:id="@+id/chart_body_fat"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_body_weight_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.Auros.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Body weight"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weigh-ins with smoothed trend (kg)"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="12dp" />

                <com.migul.treningsprogram.ui.history.BodyWeightChartView
                    android:id="@+id/chart_body_weight_body"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_body_bw_trend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_waist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.Auros.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waist"
                    android:layout_marginBottom="12dp" />

                <com.migul.treningsprogram.ui.history.StrengthChartView
                    android:id="@+id/chart_waist"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_neck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.Auros.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Neck"
                    android:layout_marginBottom="12dp" />

                <com.migul.treningsprogram.ui.history.StrengthChartView
                    android:id="@+id/chart_neck"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Hip: women only (decision 2). Never made visible for a male profile. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.Auros.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hip"
                    android:layout_marginBottom="12dp" />

                <com.migul.treningsprogram.ui.history.StrengthChartView
                    android:id="@+id/chart_hip"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Logging (secondary — collapsed until invoked, decision 10 / A7) ──────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Widget.Auros.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Measurements" />

                    <TextView
                        android:id="@+id/btn_body_log_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="Log entry"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/auros_cyan"
                        android:drawableStart="@drawable/ic_add"
                        android:drawablePadding="4dp"
                        app:drawableTint="@color/auros_cyan" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_body_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fill in whatever you measured — every field is optional."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:hint="Weight (kg)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_body_weight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Waist (cm)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_body_waist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:hint="Neck (cm)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_body_neck"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Women only (decision 2): kept GONE for a male profile, and the weight
                             of the row keeps the neck field full-width in that case. -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_body_hip"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:hint="Hip (cm)">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_body_hip"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_body_save"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save entry" />

                    <!-- The deletable history. Holds BOTH kinds of entry — body weight (including
                         Home quick-adds) and girths — so a mistyped value of either can always be
                         removed, and "Show all" reaches entries from months back. -->
                    <TextView
                        android:id="@+id/tv_body_recent_label"
                        style="@style/Widget.Auros.Eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Logged entries"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_body_recent_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap an entry to delete it."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layout_body_entries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/btn_body_show_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="8dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/auros_cyan"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
