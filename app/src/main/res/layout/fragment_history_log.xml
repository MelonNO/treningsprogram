<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- QoL item 04: the flat Sessions list became a month → week → day browser that mirrors
         the Program tab's week card. Strictly read-only history. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Training history"
            style="@style/Widget.Auros.Eyebrow" />

        <!-- Search (item requirement: must survive) — now matches exercise names too. -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Search exercises or dates…"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Calendar start/end range control (item requirement: must survive). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_date_range"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All time"
                app:icon="@drawable/ic_lucide_calendar"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_date_range_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Reset"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Empty state (no history at all, or an active filter that matches nothing). -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your training story starts with your first workout."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:padding="32dp"
            android:drawableTop="@drawable/ill_node_network"
            android:drawablePadding="16dp"
            android:visibility="gone" />

        <!-- Month browser: month eyebrows + week rows, built programmatically. -->
        <LinearLayout
            android:id="@+id/layout_browser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Week view: mirrors the Program tab's week card; shown when a week is opened.
             Wrapped in HorizontalSwipeLayout so a horizontal swipe ANYWHERE on the open week
             pages between browsable weeks (right = older, left = newer — Program-tab language)
             while chip/card taps and vertical scrolling keep working.

             The layout is now a two-pane finger-following pager: the SAME week content layout
             is included twice. The fragment renders the open week into whichever pane the
             widget reports as front; during a drag it renders the adjacent week into the back
             pane, which peeks in from the edge and follows the finger (widget owns all pane
             translation/visibility). -->
        <com.migul.treningsprogram.ui.widget.HorizontalSwipeLayout
            android:id="@+id/layout_week_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <include
                android:id="@+id/pane_week_a"
                layout="@layout/view_history_week_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/pane_week_b"
                layout="@layout/view_history_week_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.migul.treningsprogram.ui.widget.HorizontalSwipeLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
