<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <View android:layout_width="6dp" android:layout_height="6dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bg_eyebrow_dot" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SESSIONS"
                android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
        </LinearLayout>

        <!-- Search -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Search by date (e.g. 12 Jun or Thu)..."
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Stage-3 item 12: calendar start/end range control (replaces the Week/Month/3M chips).
             Default All; the Reset action reappears only while a range is active. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_date_range"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="All time"
                app:icon="@drawable/ic_lucide_calendar"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_date_range_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Reset"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Stage-3 item 2: session-card-shaped skeleton while the list loads. -->
        <LinearLayout
            android:id="@+id/skeleton_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <View android:layout_width="match_parent" android:layout_height="76dp"
                android:layout_marginBottom="12dp" android:background="@drawable/bg_skeleton_block" />
            <View android:layout_width="match_parent" android:layout_height="76dp"
                android:layout_marginBottom="12dp" android:background="@drawable/bg_skeleton_block" />
            <View android:layout_width="match_parent" android:layout_height="76dp"
                android:layout_marginBottom="12dp" android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No sessions yet. Complete a workout to see your history!"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:padding="32dp"
            android:drawableTop="@drawable/ill_node_network"
            android:drawablePadding="16dp"
            android:visibility="gone" />

        <!-- Session cards go here programmatically -->
        <LinearLayout
            android:id="@+id/layout_sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
