<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Auros hero band: eyebrow beacon → tight display title → gradient rule.
                 Item 03 (2026-08): FULL-BLEED. The band spans the whole screen width and carries
                 its own 16dp horizontal padding, so the wash reaches both screen edges while the
                 text stays indented — identical markup on Home / Program / Stats / Profile. The
                 scroll container therefore carries NO padding; the content wrapper below does. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="22dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_hero_wash">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View android:layout_width="6dp" android:layout_height="6dp"
                        android:layout_marginEnd="8dp" android:background="@drawable/bg_eyebrow_dot" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OVERVIEW"
                        android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_home_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/auros_snow" />

                <View
                    android:layout_width="52dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_gradient_accent" />
            </LinearLayout>

            <!-- Item 03: content wrapper — carries the 16dp inset the scroll container used to
                 apply, so every card below keeps its exact previous indentation. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

            <!-- First-launch welcome card (hidden once onboarding done) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_first_launch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WELCOME"
                        android:textAppearance="@style/TextAppearance.Auros.Eyebrow"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Welcome to Treningsprogram"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Let's build your first AI-powered weekly training program. It takes about 2 minutes."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:layout_marginBottom="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_setup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get Started"
                        app:backgroundTint="?attr/colorOnPrimaryContainer"
                        android:textColor="?attr/colorPrimaryContainer"
                        app:icon="@drawable/ic_arrow_up_right"
                        app:iconGravity="textEnd"
                        app:iconTint="?attr/colorPrimaryContainer" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- H1: XP / level status strip — U2: tappable to open the XP log. Kept vivid and
                 prominent (A-H1b); sits above the day's action as a slim status strip. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_xp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_level_badge"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:background="@drawable/bg_level_badge"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_xp_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:layout_marginBottom="6dp" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_xp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="100"
                                app:trackCornerRadius="4dp"
                                app:trackColor="@color/auros_reef_dim" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginStart="14dp" />

                        <!-- Floating arrow link: the card navigates to the XP log -->
                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_arrow_link">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_arrow_up_right"
                                app:tint="@color/auros_fog"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- H1: today's plan card — the day's primary action, raised directly under the
                 XP strip so "Start Workout" reliably clears the fold. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today_plan"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_today_plan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="14dp" />

                    <com.migul.treningsprogram.ui.widget.GradientButton
                        android:id="@+id/btn_start_workout"
                        style="@style/Widget.Auros.Button.Gradient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/start_workout"
                        app:icon="@drawable/ic_arrow_up_right"
                        app:iconGravity="textEnd" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- E2: deload banner. Shown only while the active program is in a stall/fatigue-
                 triggered deload week (M2), so the user can tell a deload is happening. Grouped
                 with the today card since it directly informs today's session intensity. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_deload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFB347"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_deload_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="&#127807; Deload week in effect"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="#FFB347"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_deload_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Some lifts have plateaued, so this week is a lighter deload to let you recover and break the plateau."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingMultiplier="1.15" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- N5: quiet goal nudge — shown only when an active goal is within one normal
                 progression step, so the attempt gets planned. Grouped with today's action. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_goal_nudge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/game_gold">

                <TextView
                    android:id="@+id/tv_goal_nudge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/game_gold"
                    android:lineSpacingMultiplier="1.15" />

            </com.google.android.material.card.MaterialCardView>

            <!-- B7: "your monthly Wrapped is ready" — once per new month; disappears after
                 viewing or dismissal. Discoverable, not pushy. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_wrapped_ready"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/auros_cyan">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_wrapped_ready"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/auros_cyan" />

                    <TextView
                        android:id="@+id/btn_wrapped_ready_dismiss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="✕"
                        android:textSize="14sp"
                        android:textColor="@color/auros_fog_dim" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- B5: rest-day active-recovery card — an optional invitation, never counted,
                 never streak-relevant. Per-day dismiss (x); permanent off-switch in App
                 Settings. Training days never show it. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_rest_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REST-DAY RECOVERY"
                            android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                        <TextView
                            android:id="@+id/btn_rest_recovery_dismiss"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="✕"
                            android:textSize="14sp"
                            android:textColor="@color/auros_fog_dim" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_rest_recovery_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/auros_snow"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_rest_recovery_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Optional — a rest day is complete without it."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/auros_fog_dim" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 02 (training-data 2026-08): missed-day muscle-recovery OFFER — shown only when
                 a missed day zeroed a muscle group for the week (offered, never silently applied). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_missed_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MISSED-DAY RECOVERY"
                            android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                        <TextView
                            android:id="@+id/btn_missed_recovery_dismiss"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="12dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="✕"
                            android:textSize="14sp"
                            android:textColor="@color/auros_fog_dim" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_missed_recovery_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/auros_snow"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_missed_recovery_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/btn_missed_recovery_accept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/auros_cyan" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item 03 (training-data 2026-08): never-performed planned exercise suggestion —
                 informs that the next generated week will replace it; "Keep it" opts out. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_never_performed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="PLAN CHECK-IN"
                        android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />

                    <TextView
                        android:id="@+id/tv_never_performed_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/auros_snow"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_never_performed_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/btn_never_performed_keep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="Keep in my plan"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/auros_cyan" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weekly Challenges card (H1: moved below the day's action — a reward surface,
                 not the primary action). -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WEEKLY CHALLENGES"
                            android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_home_challenges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Muscle recovery / freshness card (C4, reworked U1). H1: reference data, below
                 the action; H3 gates its visibility to when a muscle is actually recovering. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MUSCLE RECOVERY"
                            android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_home_recovery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Body weight card. H2: compact glance by default (current weight + trend);
                 the weigh-in input and recent entries reveal on demand behind "Log weight". -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header: eyebrow + on-demand "Log weight" reveal (H2) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BODY WEIGHT"
                            android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                        <TextView
                            android:id="@+id/btn_home_bw_toggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="Log weight"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/auros_cyan"
                            android:drawableStart="@drawable/ic_add"
                            android:drawablePadding="4dp"
                            app:drawableTint="@color/auros_cyan" />
                    </LinearLayout>

                    <!-- R3: current weight + smoothed trend at a glance ("78.4 kg · ↓ 0.6 kg / 4 wks").
                         Also carries the zero/one-weigh-in glance line (set in HomeFragment). -->
                    <TextView
                        android:id="@+id/tv_home_bw_trend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/auros_snow"
                        android:visibility="gone" />

                    <!-- H2: the weigh-in input + recent entries, revealed on demand via the
                         "Log weight" toggle (collapsed by default; auto-expanded on first run). -->
                    <LinearLayout
                        android:id="@+id/layout_home_bw_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:hint="Weight (kg)"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_home_bodyweight"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_home_add_weight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Log" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_home_bw_entries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recent workouts card (H1: reference data, bottom of the stack). -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recent_workouts"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_recent_sessions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Level-up overlay (shown after leveling up from a workout) -->
    <FrameLayout
        android:id="@+id/layout_level_up_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000015"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/auros_reef"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <TextView
                    android:id="@+id/tv_level_up_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#9889;"
                    android:textSize="64sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEVEL UP!"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_level_up_new_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_level_up_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/auros_fog"
                    android:gravity="center"
                    android:layout_marginBottom="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_level_up_dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Let's go!"
                    app:backgroundTint="#FFD700"
                    android:textColor="#000000"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</FrameLayout>
