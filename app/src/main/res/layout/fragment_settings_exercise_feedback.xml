<?xml version="1.0" encoding="utf-8"?>
<!-- Item 05 (2026-08-06), improvement D: review-and-undo home for per-exercise feedback. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXERCISE FEEDBACK"
            style="@style/Widget.Auros.Eyebrow"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Everything you have told the app about a specific exercise. This is a hint the AI weighs when it builds your next program — it never bans an exercise. Remove anything that is no longer true."
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_feedback_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No feedback yet. Open any exercise — tap its name while logging, or tap it on the Program tab — and choose “Give feedback”."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardElevation="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:id="@+id/layout_feedback_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
