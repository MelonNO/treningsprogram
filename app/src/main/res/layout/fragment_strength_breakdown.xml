<?xml version="1.0" encoding="utf-8"?>
<!-- Brief 02 (2026-08-07) — Strength breakdown, reached by tapping the level card on Profile.
     Auros hero band (full-bleed wash, its own 16dp inset) + a 16dp content wrapper, exactly as
     fragment_profile.xml does it. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_strength"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero band -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="22dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_hero_wash">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <View android:layout_width="6dp" android:layout_height="6dp"
                    android:layout_marginEnd="8dp" android:background="@drawable/bg_eyebrow_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STRENGTH"
                    android:textAppearance="@style/TextAppearance.Auros.Eyebrow" />
            </LinearLayout>

            <!-- The total, as a tier NAME. Never a number — that was the product decision. -->
            <TextView
                android:id="@+id/tv_strength_total_tier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="@color/auros_snow"
                tools:text="Intermediate" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_strength_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="100"
                app:trackCornerRadius="3dp"
                app:trackThickness="5dp"
                app:trackColor="@color/auros_reef_dim" />

            <TextView
                android:id="@+id/tv_strength_total_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Weighted across your rated muscle groups — 4 of 6 rated." />

        </LinearLayout>

        <!-- Content wrapper: the 16dp inset the scroll container deliberately does not carry. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Auros.Eyebrow"
                android:text="By muscle group"
                android:layout_marginBottom="10dp" />

            <!-- All six groups, always, in StrengthStandards.RATED_GROUPS order. Six fixed rows in
                 a NestedScrollView, so nested scrolling is off and the list measures in full. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_strength_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/item_strength_group" />

            <!-- Weakest rated group — INFORMS ONLY. Nothing here writes priorityMuscles; the
                 button just navigates to the setting the user edits themselves. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_strength_weakest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Auros.Eyebrow"
                        android:text="Weakest rated group"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_strength_weakest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Arms is your weakest rated group right now." />

                    <TextView
                        android:id="@+id/tv_strength_weakest_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Nothing has been changed for you." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_strength_priority"
                        style="@style/Widget.Auros.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        tools:text="Open priority muscles" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lifts that count — collapsible, collapsed by default. Secondary, but present:
                 this list is what decides whether a logged set moves a rating at all. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/header_strength_lifts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_strength_lifts_header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Widget.Auros.Eyebrow"
                            tools:text="Lifts that count" />

                        <TextView
                            android:id="@+id/tv_strength_lifts_chevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▸"
                            android:textSize="18sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_strength_lifts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_strength_lifts_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="Only these move a rating…" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The honest explainer: relative to body weight and sex, last 3 months, can go down. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_strength_explainer_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Auros.Eyebrow"
                        android:layout_marginBottom="8dp"
                        tools:text="How this works" />

                    <TextView
                        android:id="@+id/tv_strength_explainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="A rating compares your best qualifying set…" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
