<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/day_chip_padding"
    android:clickable="true"
    android:focusable="true">

    <!-- P1: badge sizes from @dimen/day_chip_badge so it shrinks on compact widths instead of
         forcing a fixed 40dp that overflows a 320dp week strip. -->
    <TextView
        android:id="@+id/tv_day_abbr"
        android:layout_width="@dimen/day_chip_badge"
        android:layout_height="@dimen/day_chip_badge"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_day_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="8sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:text="" />

    <TextView
        android:id="@+id/tv_day_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textColor="@color/auros_fog_dim"
        android:layout_marginTop="1dp"
        android:text="" />

</LinearLayout>
