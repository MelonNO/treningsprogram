<?xml version="1.0" encoding="utf-8"?>
<!-- F2: home-screen widget — today's planned workout. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_widget_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:textColor="@color/auros_fog"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:letterSpacing="-0.01"
        android:textColor="@color/auros_snow"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tv_widget_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/auros_fog" />

</LinearLayout>
